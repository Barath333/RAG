# Required
OPENAI_API_KEY=sk-...

# Optional (defaults shown)
# Use another OpenAI-compatible provider by setting a base URL, a key from that provider,
# and that provider's model names. Example for Google Gemini (free tier available):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   EMBEDDING_MODEL=gemini-embedding-001
#   CHAT_MODEL=gemini-3.8-flash
#   MIN_SIMILARITY=0.55
# If you switch embedding models, delete server/data/inbox.db first (old vectors won't match).
# OPENAI_BASE_URL=
# PORT=3001
# LOG_LEVEL=info
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
# DB_PATH=./data/inbox.db

# Chunking (characters; ~4 chars per token)
# CHUNK_MAX_CHARS=1800
# CHUNK_OVERLAP_CHARS=200

# Retrieval (0.2 suits OpenAI embeddings; Gemini embeddings need about 0.55)
# TOP_K=5
# MIN_SIMILARITY=0.2

# Ingestion limits
# MAX_NOTE_CHARS=50000
# URL_FETCH_TIMEOUT_MS=10000
# URL_MAX_BYTES=2000000
